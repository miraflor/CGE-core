* CGE-Core clean-room validation helper.
* This file contains no IFPRI source code. It serializes report parameters
* already produced by the user-supplied official model into a long CSV.
$if not set CGECORE_EXPORT_FILE $setglobal CGECORE_EXPORT_FILE cge_core_full_precision.csv
$if not set CGECORE_EXPORT_SOLVER $setglobal CGECORE_EXPORT_SOLVER UNKNOWN

FILE CGECOREFP / '%CGECORE_EXPORT_FILE%' /;
CGECOREFP.PW = 32767;
CGECOREFP.NW = 24;
CGECOREFP.NR = 4;
CGECOREFP.NZ = 0;
PUT CGECOREFP;
PUT 'solver,scenario,symbol,index1,index2,index3,value' /;

LOOP(SIMCUR, PUT '%CGECORE_EXPORT_SOLVER%', ',', SIMCUR.TL:0, ',CPI,,,,', CPIX(SIMCUR) /;);
