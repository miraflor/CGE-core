* Solver/model diagnostics and national-account targets.
LOOP((SOLVEIND,MODTYPE,SIMCUR),
  PUT '%CGECORE_EXPORT_SOLVER%', ',', SIMCUR.TL:0, ',SOLVEREP,',
      SOLVEIND.TL:0, ',', MODTYPE.TL:0, ',,',
      SOLVEREP(SOLVEIND,MODTYPE,SIMCUR) /;
);
LOOP((KGDP,IGDP,SIMCUR),
  PUT '%CGECORE_EXPORT_SOLVER%', ',', SIMCUR.TL:0, ',GDPTAB1,',
      KGDP.TL:0, ',', IGDP.TL:0, ',,',
      GDPTAB1(KGDP,IGDP,SIMCUR) /;
